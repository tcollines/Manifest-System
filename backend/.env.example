# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored — never commit it. In Dokploy, set these under
# the backend application's Environment tab instead.

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key
SUPABASE_KEY=
# Secret (service role) key — bypasses RLS, server only
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Postgres (used by migration and maintenance scripts) ---
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=

# --- Server ---
PORT=5000
NODE_ENV=production
# [SECURITY] Role escalation guards — MUST be true in production
ENFORCE_ROLE_GUARDS=true

# --- Google sign-in ---
GOOGLE_CLIENT_ID=

# --- Web push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Webhooks ---
WEBHOOK_SECRET=

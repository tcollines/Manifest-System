{
    "redirects": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "manifestsystem.vercel.app"
                }
            ],
            "destination": "https://www.manifestms.org/",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "manifestsystem.vercel.app"
                }
            ],
            "destination": "https://www.manifestms.org/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}

# Copy this file to frontend/.env (local dev) and fill in real values.
# frontend/.env is git-ignored — never commit it. In Dokploy, set these under
# the frontend application's Environment tab: Vite bakes VITE_* values into the
# bundle at BUILD time, so they must be present when the build runs.
# Everything here ends up in the browser — never put a secret/service key here.

# Backend API base URL, including /api (local: http://localhost:5000/api)
VITE_API_URL=https://<your-backend-domain>/api

# --- Supabase (publishable/anon key only) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Google ---
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GEMINI_API_KEY=

# --- Web push ---
VITE_VAPID_PUBLIC_KEY=

# --- Firebase (Manifest Forms) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FORMS_DOMAIN=https://<your-forms-domain>

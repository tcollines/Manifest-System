rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Forms (working drafts) ───────────────────────────────────────────────
    match /forms/{formId} {
      // Owner can always read. Also allow reading unclaimed forms (owner_uid='')
      // so the app can discover and claim them after the empty-uid bug.
      allow read:   if request.auth != null
                    && (request.auth.uid == resource.data.owner_uid
                        || resource.data.owner_uid == '');

      allow create: if request.auth != null;

      allow delete: if request.auth != null && request.auth.uid == resource.data.owner_uid;

      // Owner can update anything.
      // Any authenticated user can CLAIM an unclaimed form (owner_uid == '').
      // Anonymous users may ONLY increment response_count.
      allow update: if (request.auth != null && request.auth.uid == resource.data.owner_uid)
                    || (request.auth != null && resource.data.owner_uid == '')
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response_count']));
    }

    // ── Live snapshots (public form links) ───────────────────────────────────
    // Anyone can read (anonymous form visitors).
    // Any signed-in user can write — ownership is enforced in the application layer.
    match /live_forms/{formId} {
      allow read:   if true;
      allow write:  if request.auth != null;
    }

    // ── Responses ────────────────────────────────────────────────────────────
    // Anyone can submit. Only signed-in users (owners) can read/delete.
    match /responses/{responseId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }
  }
}